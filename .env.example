# Admin & Teacher Master Passphrase
ADMIN_PASSWORD=change_this_to_your_secure_password

# App Secret Key for sessions
SECRET_KEY=generate_a_random_32_char_secret_string

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard -> Access -> Tunnels)
# Leave empty if testing locally without public internet tunnel
CLOUDFLARE_TUNNEL_TOKEN=
